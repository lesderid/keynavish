name "keynavish"
description "Control the mouse with the keyboard"
authors "lesderid"
copyright "Copyright © 2021, Les De Ridder"
license "GPL-2.0"

stringImportPaths "."

targetPath "out"

// --- Windows ---------------------------------------------------------------

preBuildCommands "generate-version-info.bat" platform="windows"

libs "User32" "Gdi32" platform="windows"

lflags "/SUBSYSTEM:WINDOWS" platform="windows"

sourceFiles "src/keynavish/versioninfo.res" platform="windows"

// --- macOS -----------------------------------------------------------------

preBuildCommands "./tools/generate-version-info.sh" platform="osx"

// The Objective-C shim is compiled by clang and handed to the linker as an
// object file; D never touches AppKit directly. See MACOS-PORT.md §5.5.
// -fmodules-cache-path keeps clang's module cache inside the build tree, and
// the two -arch flags make it a fat object so one build serves both slices.
preBuildCommands "mkdir -p build && clang -c -arch arm64 -arch x86_64 -fobjc-arc -fmodules -fmodules-cache-path=build/modulecache -mmacosx-version-min=13.0 -o build/shim.o src/keynavish/platform/macos/shim.m" platform="osx"

lflags "build/shim.o" platform="osx"

lflags "-framework" "Cocoa" platform="osx"
lflags "-framework" "ServiceManagement" platform="osx"
lflags "-framework" "ApplicationServices" platform="osx"
lflags "-framework" "Carbon" platform="osx"
lflags "-framework" "IOKit" platform="osx"
